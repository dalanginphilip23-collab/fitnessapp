EMAIL_PASS=
# HTTP email API fallbacks for hosts that block outbound SMTP (e.g. Render).
# Preferred provider: Brevo (delivers to ANY recipient once BREVO_FROM is a
# verified sender at app.brevo.com -> Settings -> Senders & IP; sender must be
# a domain you control, not @gmail.com).
# BREVO_API_KEY=
# BREVO_FROM=noreply@yourdomain.com
# BREVO_FROM_NAME=Vitalis
# Fallback provider: Resend (sandbox only delivers to your own email until you
# verify a domain at resend.com/domains).
# RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev
# DEMO ONLY: when "1", /register and /resend-verification echo the verification
# link in the JSON response so accounts can be verified even if email delivery
# is sandboxed. Never enable in a real production environment.
# ALLOW_VERIFY_TOKEN_IN_RESPONSE=1
RECEIVER_EMAIL=